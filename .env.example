# Server-only preparation (SEC-04). Copy to .env without overwriting an existing file.
# Fill secrets locally from your secret manager; never paste them into Git or a client bundle.
# These settings are NOT yet consumed by the S1 in-memory API composition.
# Node 22+: node --env-file=.env scripts/check-backend-config.mjs

API_PUBLIC_URL=https://core.app.fr-par-2.octro.co
APP_ORIGINS=https://octro.co,https://www.octro.co

# PostgreSQL: authoritative business data. TLS trust must be verified on the server.
POSTGRES_ENABLED=true
PGHOST=core.data.fr-par-2.octro.co
PGPORT=5432
PGDATABASE=octro
PGUSER=app
PGPASSWORD=
PGSSLMODE=verify-full
# Optional trusted CA path for the future adapter; leave empty for system trust.
PGSSLROOTCERT=

# Extension Lending/KYC/Credit (Phase C): AES-256 keys (base64, 32 raw bytes
# each) encrypting secrets at rest that must survive a restart — user wallet
# seeds and BYO Odoo API keys. Two distinct keys, generated out-of-band
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`),
# never committed. Required whenever POSTGRES_ENABLED is true.
WALLET_SEED_ENCRYPTION_KEY=
ODOO_API_KEY_ENCRYPTION_KEY=

# MongoDB: optional raw documents only; no financial balances or access decisions.
MONGODB_ENABLED=false
MONGODB_HOST=store.data.fr-par-2.octro.co
MONGODB_PORT=27017
MONGODB_DATABASE=octro
MONGODB_USERNAME=app
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_TLS=true
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false
MONGODB_TLS_ALLOW_INVALID_HOSTNAMES=false
MONGODB_TLS_CA_FILE=

# Inferred from the supplied bucket URL; confirm region/bucket in Cloud Manager.
S3_ENABLED=true
S3_ENDPOINT_URL=https://fr-par-1.linodeobjects.com
S3_REGION=fr-par-1
S3_BUCKET=octro
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Project default (seconds), not a claim that a bucket policy is already applied.
S3_SIGNED_URL_TTL_SECONDS=300

# Didit is an adapter candidate; see docs/adr/0001-provided-infrastructure.md.
# Console login/password/TOTP are never application API credentials.
KYC_ENABLED=false
KYC_PROVIDER=didit
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_URL=

# Exact mailing API contract is not accessible yet. No endpoint/header is guessed.
MAIL_ENABLED=false
MAIL_API_BASE_URL=
MAIL_API_TOKEN=
MAIL_API_AUTH_HEADER=
MAIL_API_SEND_PATH=

# Extension Lending/KYC/Credit (Phase E): false/unset -> FakeLendingV1Adapter
# (no network call, deterministic — used by the test suite and before the
# shared vault/broker is bootstrapped). true -> the real, already-verified
# XRPL adapter (packages/xrpl/src/lending-v1.ts) against the Custom
# Hackathon Devnet. Requires the shared pool to have been bootstrapped once
# (see infra/scripts/bootstrap-lending-pool.mjs) before any deposit/loan
# route will find a vault/broker to use.
LENDING_V1_ENABLED=false

# Real buffer liquidity wallet (Phase F) — advances a lender's withdrawal
# when the vault itself cannot cover it yet (borrower not repaid). Provided
# out-of-band by the team, never generated by this codebase.
BUFFER_WALLET_ADDRESS=
BUFFER_WALLET_SEED=
# Starting balance (drops) for the internal buffer ledger, seeded once on
# the first advance ever needed — align with the wallet's real balance.
BUFFER_INITIAL_BALANCE_DROPS=1000000000

# SSH passwords, console credentials and XRPL seeds do not belong in this file.
